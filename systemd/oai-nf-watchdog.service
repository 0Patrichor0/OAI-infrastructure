[Unit]
Description=Watchdog for OAI SMF/UDR (libnghttp2_asio segfault) + NWDAF SBI subscription recovery
After=docker.service

[Service]
RuntimeDirectory=oai-nf-watchdog
RuntimeDirectoryMode=0750
Type=oneshot
User=ubuntu
SupplementaryGroups=docker
ExecStart=/usr/bin/flock -n /run/oai-nf-watchdog/watchdog.lock /home/ubuntu/nwdaf-rel17/systemd/oai-nf-watchdog.sh
TimeoutStartSec=1200
Nice=10
