[Unit]
Description=Continuous UE traffic generator (keeps SMF/NWDAF data flowing)
After=oran-ue.service
Wants=oran-ue.service

[Service]
Type=simple
ExecStart=/home/ubuntu/nwdaf-rel17/systemd/oran-traffic.sh
Restart=always
RestartSec=15
StandardOutput=append:/home/ubuntu/oai-ran-logs/traffic.log
StandardError=append:/home/ubuntu/oai-ran-logs/traffic.log

[Install]
WantedBy=multi-user.target
