   assert(s != NULL);
 
   lock_guard(&m->mtx);
+  /* A peer can shut down before E2 Setup, or notify shutdown twice. */
+  assoc_rb_tree_t* tree = &m->map.right;
+  if (assoc_size(tree) == 0)
