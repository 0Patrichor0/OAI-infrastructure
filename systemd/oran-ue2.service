[Unit]
Description=OAI nrUE node #2 (netns ue2, IMSI 208950000000031)
After=network-online.target oran-du.service
Wants=oran-du.service

[Service]
Type=simple
# netns/veth 是易失资源，每次启动前幂等重建
ExecStartPre=/home/ubuntu/oai-ran-conf/ue-netns-setup.sh 2
ExecStart=/usr/sbin/ip netns exec ue2 /home/ubuntu/oai-ran-e2/cmake_targets/ran_build/build/nr-uesoftmodem -O /home/ubuntu/oai-ran-conf/ue2.conf -r 106 --numerology 1 --band 78 -C 3450720000 --rfsim
Restart=always
RestartSec=10
TimeoutStopSec=15
KillMode=mixed
StandardOutput=append:/home/ubuntu/oai-ran-logs/ue2.log
StandardError=append:/home/ubuntu/oai-ran-logs/ue2.log

[Install]
WantedBy=multi-user.target
