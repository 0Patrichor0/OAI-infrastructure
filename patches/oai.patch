+sm_ag_if_ans_t write_ctrl_mac_sm(void const *data)
+{
+  static uint64_t revision;
+  sm_ag_if_ans_t ans = {.type = CTRL_OUTCOME_SM_AG_IF_ANS_V0};
+  ans.ctrl_out.type = MAC_AGENT_IF_CTRL_ANS_V0;
+  if (!data)
+    return ans;
+  const mac_ctrl_req_data_t *request = data;
+  if (intent_prb_is_command(request->msg.action))
+    return write_ctrl_prb_policy(request);
+  if (request->hdr.dummy != INTENT_MCS_MAGIC) {
+    printf("[E2-MCS] Unsupported MAC control header; scheduler unchanged\n");
+    return ans;
+  }
+  gNB_MAC_INST *mac = RC.nrmac ? RC.nrmac[0] : NULL;
+  if (!mac)
+    return ans;
+
+  uint32_t word = request->msg.action;
+  unsigned token = (word >> 6) & INTENT_MCS_TOKEN_MASK;
+  unsigned op = word >> 30;
+  unsigned before, after, minimum;
+  bool applied;
+  uint64_t bytes = 0;
+  unsigned users = 0;
+  NR_SCHED_LOCK(&mac->sched_lock);
+  nr_cell_sched_t *cell = &mac->cells[0];
+  before = cell->dl_bler.max_mcs;
+  minimum = cell->dl_bler.min_mcs;
+  applied = cell->common_channels.ServingCellConfigCommon != NULL
+            && intent_mcs_apply(request->hdr.dummy, word, minimum, &cell->dl_bler.max_mcs);
+  after = cell->dl_bler.max_mcs;
+  if (applied && op == INTENT_MCS_SET)
+    revision++;
+  uint64_t current_revision = revision;
+  UE_iterator(mac->UE_info.connected_ue_list, UE) {
+    if (UE->pcell == cell) {
+      users++;
+      bytes += UE->mac_stats.dl.total_bytes;
+    }
+  }
+  NR_SCHED_UNLOCK(&mac->sched_lock);
+
+  const char *directory = getenv("OAI_E2_CONTROL_STATE_DIR");
+  if (!directory)
+    directory = "/run/oran-du-e2-control";
+  char temporary[512], target[512];
+  int temporary_len = snprintf(temporary, sizeof(temporary), "%s/state.%d.tmp", directory, getpid());
+  int target_len = snprintf(target, sizeof(target), "%s/state.json", directory);
+  if (temporary_len < 0 || (size_t)temporary_len >= sizeof(temporary)
+      || target_len < 0 || (size_t)target_len >= sizeof(target))
+    return ans;
+  int fd = open(temporary, O_WRONLY | O_CREAT | O_TRUNC | O_NOFOLLOW, 0644);
+  if (fd >= 0) {
+    int written = dprintf(fd,
+        "{\"schema\":1,\"pid\":%d,\"token\":%u,\"op\":%u,\"ok\":%s,"
+        "\"before\":%u,\"dl_max_mcs\":%u,\"dl_min_mcs\":%u,\"cell_index\":0,"
+        "\"users\":%u,\"dl_bytes\":%llu,\"revision\":%llu,\"timestamp_us\":%lld}\n",
+        getpid(), token, op, applied ? "true" : "false", before, after, minimum,
+        users, (unsigned long long)bytes, (unsigned long long)current_revision, (long long)time_now_us());
+    bool saved = written > 0 && fsync(fd) == 0;
+    close(fd);
+    if (!saved || rename(temporary, target) != 0)
+      unlink(temporary);
+  }
+  printf("[E2-MCS] token=%u op=%u applied=%d cell=0 before=%u current=%u\n", token, op, applied, before, after);
+  return ans;
+}
